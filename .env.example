# CLIProxyAPI base URL — used as default for the OMP extension.
# Also read by integration tests.
CLIPROXY_BASE_URL=https://your-cpa-host/v1

# Optional API key — used when /cliproxy-connect is not invoked.
CLIPROXY_API_KEY=

# Optional: override model used in integration chat-completion test
# CLIPROXY_TEST_MODEL=gpt-5.4-mini
